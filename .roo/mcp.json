{
	"mcpServers": {
		"next-devtools": {
			"command": "npx",
			"args": [
				"-y",
				"next-devtools-mcp@latest"
			],
			"alwaysAllow": [
				"browser_eval"
			]
		},
		"Prisma-Local": {
			"command": "npx",
			"args": [
				"-y",
				"prisma",
				"mcp"
			],
			"alwaysAllow": [
				"migrate-status"
			]
		},
		"shadcn": {
			"command": "npx",
			"args": [
				"shadcn@latest",
				"mcp"
			],
			"alwaysAllow": [
				"get_project_registries",
				"list_items_in_registries",
				"search_items_in_registries",
				"view_items_in_registries",
				"get_item_examples_from_registries",
				"get_add_command_for_items",
				"get_audit_checklist"
			]
		}
	}
}