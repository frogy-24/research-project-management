generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  LECTURER
  DEAN
  ADMIN
  COUNCIL
  LEADER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  DEAN_APPROVED
  DEAN_REVISION
  ADMIN_REVIEW
  COUNCIL_EVALUATING
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  SUSPENDED
}

enum ReviewDecision {
  PASS
  NEED_REVISION
  FAIL
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CallRoundApprovalStatus {
  PENDING_APPROVAL // Trưởng khoa tạo, chờ admin duyệt
  APPROVED // Admin đã duyệt (hoặc admin tự tạo)
  REJECTED // Admin từ chối
}

enum InvitationStatus {
  PENDING // Chờ phản hồi
  ACCEPTED // Đã đồng ý
  REJECTED // Đã từ chối
}

enum ApplicableFor {
  STUDENT // Áp dụng cho sinh viên
  LECTURER // Áp dụng cho giảng viên
  BOTH // Áp dụng cho cả hai
}

enum RegistrationStatus {
  PENDING
  APPROVED
  CANCELED
  REJECTED
}

enum DisbursementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectClosingStatus {
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
}

enum AutoApprovalJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ReportJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Department {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  majors      Major[]
  users       User[]
  callRounds  CallRound[] @relation("CallRoundDepartments")
  rooms       Room[]
  posts       Post[]
}

model Major {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  description  String?
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  classes      Class[]
  users        User[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  callRounds   CallRound[] @relation("CallRoundMajors")
}

model Class {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  majorId    String
  major      Major       @relation(fields: [majorId], references: [id], onDelete: Cascade)
  users      User[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  callRounds CallRound[] @relation("CallRoundClasses")
}

model User {
  id                         String                    @id @default(cuid())
  code                       String?                   @unique
  name                       String
  email                      String                    @unique
  password                   String?
  dateOfBirth                DateTime?
  gender                     Gender?
  phone                      String?
  address                    String?
  role                       Role                      @default(LECTURER)
  department                 String? // Legacy field, keep for backward compatibility
  departmentId               String?
  departmentRef              Department?               @relation(fields: [departmentId], references: [id])
  majorId                    String?
  major                      Major?                    @relation(fields: [majorId], references: [id])
  classId                    String?
  class                      Class?                    @relation(fields: [classId], references: [id])
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  leadProjects               Project[]                 @relation("ProjectLeader")
  deanReviews                Project[]                 @relation("DeanReviewer")
  councilEvaluations         CouncilEvaluation[]
  registrations              ProjectRegistration[]
  instructedRegistrations    ProjectRegistration[]     @relation("ProjectRegistrationInstructor")
  instructedProjects         Project[]                 @relation("ProjectInstructor")
  facultyReviews             ProjectRegistration[]     @relation("FacultyReviewer")
  notifications              Notification[]
  callRoundInstructors       CallRoundInstructor[] // Danh sách đợt đăng ký mà giảng viên được chỉ định hướng dẫn
  callRoundCouncilMembers    CallRoundCouncilMember[] // Danh sách đợt đăng ký mà thành viên hội đồng được chỉ định
  councilAssignments         CouncilMemberAssignment[] @relation("CouncilMemberAssignments") // Phân công vào các hội đồng cụ thể
  officeMeetingsAsInstructor OfficeMeeting[]           @relation("OfficeMeetingInstructor")
  officeMeetingViews         OfficeMeetingView[]
  posts                      Post[]                    @relation("PostAuthor")
  approvedPosts              Post[]                    @relation("PostApprover")
  createdDisbursements       FundingDisbursement[]     @relation("DisbursementCreator")
  approvedDisbursements      FundingDisbursement[]     @relation("DisbursementApprover")
  autoApprovalJobs           AutoApprovalJob[]         @relation("DeanAutoApprovalJobs")
}

model CallRound {
  id          String  @id @default(cuid())
  name        String
  description String? // Mô tả chi tiết về đợt đăng ký

  // Thời gian đăng ký
  registrationStartDate DateTime // Thời gian bắt đầu đăng ký
  registrationEndDate   DateTime // Thời gian kết thúc đăng ký

  // Thời gian thực hiện đề tài
  projectStartDate DateTime? // Thời gian bắt đầu thực hiện đề tài
  projectEndDate   DateTime? // Thời gian dự kiến kết thúc đề tài

  // Các mốc thời gian khác
  reviewDeadline     DateTime? // Hạn chót duyệt đề tài
  reportingStartDate DateTime? // Thời gian bắt đầu báo cáo tiến độ
  defenseDate        DateTime? // Ngày bảo vệ đề tài
  projectLockDate    DateTime? // Ngày chốt đề tài (hạn chót đăng ký)

  // Legacy fields (keep for backward compatibility)
  startDate DateTime // Maps to registrationStartDate
  endDate   DateTime // Maps to registrationEndDate

  // Thông tin bổ sung
  maxProjects  Int? // Số lượng đề tài tối đa được chấp nhận
  budgetLimit  Decimal? @db.Decimal(12, 2) // Ngân sách tối đa cho đợt
  requirements String? // Yêu cầu, điều kiện đăng ký
  guidelines   String? // Hướng dẫn đăng ký
  contactInfo  String? // Thông tin liên hệ

  isActive Boolean @default(true)
  isLocked Boolean @default(false) // Khóa chỉnh sửa

  // Áp dụng cho đối tượng nào
  applicableFor ApplicableFor @default(STUDENT) // STUDENT, LECTURER, hoặc BOTH

  // Approval workflow: DEAN creates -> PENDING_APPROVAL, ADMIN creates -> APPROVED
  approvalStatus CallRoundApprovalStatus @default(APPROVED)
  createdById    String? // ID người tạo
  createdByRole  Role? // Role người tạo
  approvedById   String? // ID admin duyệt
  approvalNote   String? // Ghi chú khi duyệt/từ chối
  approvedAt     DateTime? // Thời điểm duyệt

  templateId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  projects                Project[]
  registrations           ProjectRegistration[]
  template                ProgressReportTemplate?  @relation(fields: [templateId], references: [id])
  departments             Department[]             @relation("CallRoundDepartments")
  majors                  Major[]                  @relation("CallRoundMajors")
  classes                 Class[]                  @relation("CallRoundClasses")
  availableInstructors    CallRoundInstructor[] // Danh sách giảng viên hướng dẫn được chỉ định cho đợt này
  availableCouncilMembers CallRoundCouncilMember[] // Danh sách thành viên hội đồng được chỉ định cho đợt này
  // Thời hạn phản hồi lời mời tham gia
  invitationDeadline      DateTime? // Hạn chót để giảng viên/thành viên hội đồng phản hồi lời mời

  councils    Council[] // Các hội đồng được tạo trong đợt này
  attachments CallRoundAttachment[] // File đính kèm của đợt đăng ký
}

model ProjectType {
  id        String    @id @default(cuid())
  name      String    @unique
  budgetCap Decimal?  @db.Decimal(12, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id                 String                    @id @default(cuid())
  code               String?                   @unique
  title              String
  objective          String
  expectedOutput     String?
  proposalFileUrl    String?
  budgetRequested    Decimal?                  @db.Decimal(12, 2)
  budgetApproved     Decimal?                  @db.Decimal(12, 2)
  status             ProjectStatus             @default(DRAFT)
  overdueReportCount Int                       @default(0)
  budgetSuspended    Boolean                   @default(false)
  leaderId           String
  deanReviewerId     String?
  callRoundId        String?
  projectTypeId      String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  leader             User                      @relation("ProjectLeader", fields: [leaderId], references: [id])
  deanReviewer       User?                     @relation("DeanReviewer", fields: [deanReviewerId], references: [id])
  callRound          CallRound?                @relation(fields: [callRoundId], references: [id])
  projectType        ProjectType?              @relation(fields: [projectTypeId], references: [id])
  progressReports    ProgressReport[]
  councilEvaluations CouncilEvaluation[]
  disbursements      FundingDisbursement[]
  extensionRequests  ExtensionRequest[]
  closingSubmission  ProjectClosingSubmission?
  instructorId       String?
  instructor         User?                     @relation("ProjectInstructor", fields: [instructorId], references: [id])
  officeMeetings     OfficeMeeting[]
}

model ProjectClosingSubmission {
  id                                     String               @id @default(cuid())
  projectId                              String               @unique
  project                                Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedById                          String
  status                                 ProjectClosingStatus @default(SUBMITTED)
  note                                   String?
  reportFiles                            Json?
  researchSourceCodeFiles                Json?
  researchGuideFiles                     Json?
  administrativeDefenseApplicationFiles  Json?
  administrativeAchievementEvidenceFiles Json?
  administrativeAdvisorReviewFiles       Json?
  presentationSlideFiles                 Json?
  presentationVideoFiles                 Json?
  submittedAt                            DateTime             @default(now())
  createdAt                              DateTime             @default(now())
  updatedAt                              DateTime             @updatedAt

  @@index([submittedById])
  @@index([status])
}

model ProgressReportTemplate {
  id            String                       @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean                      @default(true)
  createdById   String? // ID người tạo
  createdByRole Role? // Role người tạo
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  items         ProgressReportTemplateItem[]
  callRounds    CallRound[]
}

model ProgressReportTemplateItem {
  id               String                 @id @default(cuid())
  templateId       String
  weekNumber       Int
  weekLabel        String
  taskDescription  String
  contentGuideline String?
  expectedResult   String?
  orderIndex       Int
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  template         ProgressReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, weekNumber])
  @@index([templateId, orderIndex])
}

model ProgressReport {
  id               String    @id @default(cuid())
  projectId        String
  week             Int?
  fromDate         DateTime?
  toDate           DateTime?
  tasks            String?
  performedContent String?
  results          String?
  reportContent    String?

  periodLabel  String
  summary      String
  fileUrl      String?
  mentorReview String?
  mentorScore  Float?
  submittedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CouncilEvaluation {
  id              String         @id @default(cuid())
  projectId       String
  councilMemberId String
  score           Float
  decision        ReviewDecision
  comment         String?
  evaluatedAt     DateTime       @default(now())
  createdAt       DateTime       @default(now())
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  councilMember   User           @relation(fields: [councilMemberId], references: [id])
}

model FundingDisbursement {
  id             String             @id @default(cuid())
  projectId      String
  amount         Decimal            @db.Decimal(12, 2)
  disbursedAt    DateTime
  voucherNo      String?
  voucherFileUrl String?
  reason         String? // Lý do giải ngân
  status         DisbursementStatus @default(PENDING)
  createdById    String // Người tạo yêu cầu (Dean hoặc Admin)
  approvedById   String? // Người phê duyệt (Admin)
  approvedAt     DateTime? // Ngày phê duyệt
  rejectionNote  String? // Ghi chú khi từ chối
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User               @relation("DisbursementCreator", fields: [createdById], references: [id])
  approvedBy     User?              @relation("DisbursementApprover", fields: [approvedById], references: [id])

  @@index([projectId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
}

model ExtensionRequest {
  id              String        @id @default(cuid())
  projectId       String
  requestedMonths Int
  reason          String
  status          RequestStatus @default(PENDING)
  submittedAt     DateTime      @default(now())
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectRegistration {
  id               String             @id @default(cuid())
  userId           String
  callRoundId      String?
  title            String
  objective        String
  expectedOutput   String?
  proposalFiles    Json?
  teamMembers      Json?
  status           RegistrationStatus @default(PENDING)
  cancelReason     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  instructorId     String?
  instructorStatus InstructorStatus   @default(PENDING)
  instructor       User?              @relation("ProjectRegistrationInstructor", fields: [instructorId], references: [id])
  callRound        CallRound?         @relation(fields: [callRoundId], references: [id])

  facultyStatus     FacultyStatus             @default(PENDING)
  facultyReviewerId String?
  facultyReviewer   User?                     @relation("FacultyReviewer", fields: [facultyReviewerId], references: [id])
  councilAssignment ProjectCouncilAssignment? // Hội đồng được phân công đánh giá đề tài này
}

enum InstructorStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum FacultyStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  PROJECT_STATUS_CHANGE
  REGISTRATION_STATUS_CHANGE
  PROGRESS_REPORT_SUBMITTED
  PROGRESS_REPORT_REVIEWED
  EXTENSION_REQUEST_SUBMITTED
  EXTENSION_REQUEST_REVIEWED
  CALL_ROUND_APPROVED
  CALL_ROUND_REJECTED
  INSTRUCTOR_ASSIGNED
  DEAN_REVIEW_ASSIGNED
  COUNCIL_EVALUATION_SUBMITTED
  FUNDING_DISBURSED
}

enum PostAudience {
  LECTURERS
  STUDENTS
  DEPARTMENT
  ALL
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String? // URL to navigate to when clicked
  isRead    Boolean          @default(false)
  metadata  Json? // Additional data like projectId, registrationId, etc.
  createdAt DateTime         @default(now())
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Post {
  id              String       @id @default(cuid())
  title           String
  content         String
  audience        PostAudience @default(ALL)
  status          PostStatus   @default(PENDING)
  authorId        String
  authorRole      Role
  author          User         @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  approvedById    String?
  approvedBy      User?        @relation("PostApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([audience, status])
  @@index([departmentId, status])
  @@index([authorId, createdAt])
}

model Room {
  id           String     @id @default(cuid())
  name         String // VD: "Phòng họp A", "Phòng B201"
  code         String // Mã phòng, VD: "B201"
  capacity     Int? // Sức chứa (tùy chọn)
  description  String? // Mô tả thêm
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  officeMeetings OfficeMeeting[]

  @@unique([code, departmentId])
  @@index([departmentId])
}

model OfficeMeeting {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  instructorId  String
  instructor    User     @relation("OfficeMeetingInstructor", fields: [instructorId], references: [id])
  target        String // "GROUP" or "LEADER"
  memberUserIds String[] // List of user IDs for invited members
  meetingAt     DateTime
  location      String
  roomId        String? // Tham chiếu tới phòng họp (tùy chọn)
  room          Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Quan hệ cho phần receipt status
  views OfficeMeetingView[]

  @@index([projectId])
  @@index([instructorId])
  @@index([roomId])
}

model OfficeMeetingView {
  id        String        @id @default(cuid())
  meetingId String
  meeting   OfficeMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead    Boolean       @default(false)
  readAt    DateTime?

  @@unique([meetingId, userId])
  @@index([userId])
}

// Junction table: Danh sách giảng viên hướng dẫn được chỉ định cho mỗi đợt đăng ký
model CallRoundInstructor {
  id               String           @id @default(cuid())
  callRoundId      String
  instructorId     String
  invitationStatus InvitationStatus @default(PENDING) // Trạng thái phản hồi lời mời
  respondedAt      DateTime? // Thời điểm phản hồi
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  callRound  CallRound @relation(fields: [callRoundId], references: [id], onDelete: Cascade)
  instructor User      @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([callRoundId, instructorId])
  @@index([callRoundId])
  @@index([instructorId])
  @@index([invitationStatus])
}

// Junction table: Danh sách thành viên hội đồng được chỉ định cho mỗi đợt đăng ký
model CallRoundCouncilMember {
  id               String           @id @default(cuid())
  callRoundId      String
  councilMemberId  String
  invitationStatus InvitationStatus @default(PENDING) // Trạng thái phản hồi lời mời
  respondedAt      DateTime? // Thời điểm phản hồi
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  callRound     CallRound @relation(fields: [callRoundId], references: [id], onDelete: Cascade)
  councilMember User      @relation(fields: [councilMemberId], references: [id], onDelete: Cascade)

  @@unique([callRoundId, councilMemberId])
  @@index([callRoundId])
  @@index([councilMemberId])
  @@index([invitationStatus])
}

// Model: Hội đồng đánh giá (được chia tự động hoặc thủ công)
model Council {
  id              String    @id @default(cuid())
  callRoundId     String
  name            String // VD: "Hội đồng 1", "Hội đồng A"
  description     String?
  defenseDate     DateTime?
  defenseLocation String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  callRound CallRound                  @relation(fields: [callRoundId], references: [id], onDelete: Cascade)
  members   CouncilMemberAssignment[] // Thành viên của hội đồng này
  projects  ProjectCouncilAssignment[] // Đề tài được phân cho hội đồng này

  @@index([callRoundId])
}

// Auto Approval Job - Phê duyệt tự động với LLM
model AutoApprovalJob {
  id          String                @id @default(cuid())
  deanId      String
  dean        User                  @relation("DeanAutoApprovalJobs", fields: [deanId], references: [id], onDelete: Cascade)
  filters     Json // Điều kiện lọc đề tài
  criteria    Json // Tiêu chí đánh giá từ user
  status      AutoApprovalJobStatus @default(QUEUED)
  progress    Int                   @default(0) // 0-100
  results     Json? // Kết quả từ LLM
  error       String? // Lỗi nếu có
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  completedAt DateTime? // Thời điểm hoàn thành

  @@index([deanId, status])
  @@index([createdAt])
}

// Report Template - Mẫu báo cáo upload
model ReportTemplate {
  id         String   @id @default(cuid())
  name       String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  jobs ReportJob[]

  @@index([uploadedBy])
}

// Report Generation Job - Tạo báo cáo với RabbitMQ + LLM
model ReportJob {
  id           String          @id @default(cuid())
  deanId       String
  reportType   String // Loại báo cáo (VD: "project_summary", "budget_report")
  templateUrl  String? // URL file template upload
  templateId   String? // FK tới ReportTemplate
  callRoundId  String? // Đợt đăng ký liên quan
  templateType String? // Loại template ("default", "uploaded")
  parameters   Json // Tham số lọc (date range, callRoundId, etc.)
  status       ReportJobStatus @default(QUEUED)
  progress     Int             @default(0) // 0-100
  resultUrl    String? // URL file báo cáo đã tạo
  error        String? // Lỗi nếu có
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  completedAt  DateTime? // Thời điểm hoàn thành

  template ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([deanId, status])
  @@index([createdAt])
}

// Junction table: Phân công thành viên vào hội đồng cụ thể
model CouncilMemberAssignment {
  id              String   @id @default(cuid())
  councilId       String
  councilMemberId String
  role            String? // VD: "Chủ tịch", "Thư ký", "Ủy viên"
  createdAt       DateTime @default(now())

  council       Council @relation(fields: [councilId], references: [id], onDelete: Cascade)
  councilMember User    @relation("CouncilMemberAssignments", fields: [councilMemberId], references: [id], onDelete: Cascade)

  @@unique([councilId, councilMemberId])
  @@index([councilId])
  @@index([councilMemberId])
}

// Junction table: Phân công đề tài cho hội đồng
model ProjectCouncilAssignment {
  id                    String   @id @default(cuid())
  councilId             String
  projectRegistrationId String
  createdAt             DateTime @default(now())

  council             Council             @relation(fields: [councilId], references: [id], onDelete: Cascade)
  projectRegistration ProjectRegistration @relation(fields: [projectRegistrationId], references: [id], onDelete: Cascade)

  @@unique([projectRegistrationId]) // Mỗi đề tài chỉ thuộc 1 hội đồng
  @@index([councilId])
}

// File đính kèm của đợt đăng ký
model CallRoundAttachment {
  id          String   @id @default(cuid())
  callRoundId String
  fileName    String // Tên file gốc
  fileUrl     String // URL lưu trữ file
  fileSize    Int? // Kích thước file (bytes)
  fileType    String? // MIME type hoặc extension
  description String? // Mô tả ngắn về file
  createdAt   DateTime @default(now())

  callRound CallRound @relation(fields: [callRoundId], references: [id], onDelete: Cascade)

  @@index([callRoundId])
}
